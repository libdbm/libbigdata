# Files excluded from the published pub.dev archive.
#
# Where this file exists, pub reads it INSTEAD of .gitignore, so every path
# .gitignore keeps out of the repository that must also stay out of the
# archive is listed here too.

# Tests and their fixtures.
test/
dart_test.yaml

# Benchmarks, including the compiled Java comparison jar.
benchmark/

# Interop harness (requires python + pyspark/deltalake/pyiceberg).
tool/

# Build and editor state.
.dart_tool/
.idea/
build/

# Agent and contributor instructions, and the working plan.
SPEC*.md
.claude/
.junie/
AGENTS.md
CLAUDE.md
tasks/

# Logs written by the CLI and the logging example.
logs/

# Local toolchain pins.
.java-version

# Local build helpers.
build.sh
Makefile

# Resolved versions are not meaningful for a library package.
pubspec.lock

# Root-level benchmark output.
/*.parquet

# OS cruft.
.DS_Store
